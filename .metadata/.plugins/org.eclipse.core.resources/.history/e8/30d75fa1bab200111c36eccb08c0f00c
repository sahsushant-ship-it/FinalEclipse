package com.numbers;

public class AllPerfectNum {
	public static void perfectNum(int n ) {
		for(int num = 1; num<=n; num++) {
			int sum = 0;
			for(int i =1;i<num;i++) {
				sum += i;
			}
			if(num==sum) {
				System.out.println(num);
			}
		}
		}
	public static void main(String[] args) {
		int n = 100;
		perfectNum(n);
	}
		

}
