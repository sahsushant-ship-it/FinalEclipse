package com.numbers;

public class PrimeNumb {
	public static void primeNum(int n) {
		for(int num = 2; num<=n; num++) {
			boolean isPrime= true;
			for(int i = 2; i<num; i++) {
				if(num%i==0) {
					isPrime= false;
					break;
				}
			}
			if(isPrime) {
				System.out.println(num);
			}
		}
	}

}
