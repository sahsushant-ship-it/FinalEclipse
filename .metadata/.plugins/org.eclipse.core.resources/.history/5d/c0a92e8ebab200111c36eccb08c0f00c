package com.numbers;

public class AllPerfectNum {
	public static void perfectNum(int n) {
		for(int num = 1; num<=n; num++) {
			int sum = 0;
			for(int i = 1; i<num; i++) {
				if(num%i==0) {
					sum += num;
				}
			}
			if(num==sum) {
				System.out.println(num);
			}
		}
	}
	public static void main(String[] args) {
		int n = 1000;
		perfectNum(n);
	}

}
